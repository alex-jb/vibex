# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.claude/scheduled_tasks.lock

# ═══ PROPRIETARY (private core — not tracked) ═══
# Real implementations stored locally, public repo has stubs only.
.private/
.env*.local

# ═══ DEMO MP4s — served from Vercel Blob, not committed ═══
# /investors + DemoVertical reference Blob URLs. Re-render locally,
# upload with `npm run demo:sync-blob`. PNG screenshots stay tracked.
public/demo-assets/*.mp4

# Dogfood / eval output
out/dogfood-vibex-launch/
