# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic API (for AI features)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────────────────────────
# Provider abstraction — scaffold 2026-06-14
# ─────────────────────────────────────────────────────────────
# Pick which LLM provider runs VibeXForge AI calls. Default: claude.
# Currently only generateProjectReview() is routed through the shim.
# Phase 2 will port generateStructuredReview / evaluateIdea / etc.
# See docs/provider-abstraction-2026-06-14.md.
# AI_PROVIDER=claude
# AI_PROVIDER=kimi
# AI_PROVIDER=deepseek
# AI_PROVIDER=glm
# AI_PROVIDER=qwen

# Only set the key matching your AI_PROVIDER choice.
# KIMI_API_KEY=sk-your-moonshot-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# GLM_API_KEY=your-zhipu-glm-key
# QWEN_API_KEY=sk-your-dashscope-key
