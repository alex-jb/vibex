{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(exclude)*.md' ':(exclude)docs/**' ':(exclude).github/**' ':(exclude)remotion/**' ':(exclude)out/**' ':(exclude)scripts/screenshot-*.mjs' ':(exclude)scripts/_probe*.mjs'"
}
