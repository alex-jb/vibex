{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(exclude)*.md' ':(exclude)docs/**' ':(exclude).github/**' ':(exclude)remotion/**' ':(exclude)out/**' ':(exclude)scripts/**'",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/daily-owner-summary",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/scrape-engagement",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/translate-zh",
      "schedule": "0 3 * * *"
    }
  ]
}
