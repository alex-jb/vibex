{
  "name": "vibex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:migrations": "node scripts/audit-migrations.mjs scripts/migration-inventory.json",
    "audit:dump": "node scripts/dump-inventory.mjs scripts/migration-inventory.json",
    "screenshot:v3": "node scripts/screenshot-v3.mjs",
    "remotion:dev": "remotion studio remotion/src/index.ts",
    "remotion:render": "remotion render remotion/src/index.ts Vibex out/vibex-hero-v3.mp4 --codec=h264 --crf=18 --concurrency=4",
    "remotion:render-zh": "remotion render remotion/src/index.ts Vibex out/vibex-hero-v3-zh.mp4 --props='{\"locale\":\"zh\"}' --codec=h264 --crf=18",
    "remotion:demo": "remotion render remotion/src/index.ts Demo out/vibex-demo-v1.mp4 --codec=h264 --crf=18 --concurrency=4",
    "remotion:demo-zh": "remotion render remotion/src/index.ts Demo out/vibex-demo-v1-zh.mp4 --props='{\"locale\":\"zh\"}' --codec=h264 --crf=18 --concurrency=4",
    "remotion:demo-vc": "remotion render remotion/src/index.ts DemoVC out/vibex-demo-vc-v1.mp4 --codec=h264 --crf=18 --concurrency=4",
    "remotion:demo-vc-zh": "remotion render remotion/src/index.ts DemoVC out/vibex-demo-vc-v1-zh.mp4 --props='{\"locale\":\"zh\"}' --codec=h264 --crf=18 --concurrency=4",
    "remotion:demo-vertical": "remotion render remotion/src/index.ts DemoVertical out/vibex-demo-vertical-v1.mp4 --codec=h264 --crf=18 --concurrency=4",
    "remotion:demo-vertical-zh": "remotion render remotion/src/index.ts DemoVertical out/vibex-demo-vertical-v1-zh.mp4 --props='{\"locale\":\"zh\"}' --codec=h264 --crf=18 --concurrency=4",
    "remotion:og-image": "remotion still remotion/src/index.ts OgImage out/vibex-og-image.png --frame=0",
    "demo:sync-blob": "node scripts/sync-demo-blob.mjs",
    "compress:pngs": "node scripts/compress-pngs.mjs public/demo-assets/ public/generated/",
    "gen:pitch-pptx": "node scripts/gen-pitch-pptx.mjs both"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@base-ui/react": "^1.3.0",
    "@hyperdx/browser": "^0.22.1",
    "@openpanel/nextjs": "^1.5.0",
    "@remotion/google-fonts": "^4.0.450",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "gif-encoder-2": "^1.0.5",
    "lucide-react": "^1.7.0",
    "nes.css": "^2.2.1",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google/genai": "^1.50.1",
    "@playwright/test": "^1.59.1",
    "@remotion/bundler": "^4.0.320",
    "@remotion/cli": "^4.0.320",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "happy-dom": "^20.9.0",
    "remotion": "^4.0.320",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
